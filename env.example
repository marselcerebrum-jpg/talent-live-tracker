# Live Hub. Supabase project: talent-live-tracker (ref qbunkjdkhuawbmzhklgs)
NEXT_PUBLIC_SUPABASE_URL=https://qbunkjdkhuawbmzhklgs.supabase.co
# Dashboard > Project Settings > API Keys > anon / publishable key (aman untuk browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dashboard > Project Settings > API Keys > service_role / secret key (RAHASIA, hanya di server)
# Dipakai untuk membuat akun login talent dari halaman admin.
SUPABASE_SERVICE_ROLE_KEY=

# Rahasia untuk endpoint /api/promo/ingest (data kode promo dari Centil). Isi string acak panjang.
PROMO_INGEST_SECRET=


# Opsional: email pemberitahuan ke admin (permintaan ubah kata sandi) via https://resend.com
RESEND_API_KEY=
# Opsional: penerima, dipisah koma. Default: semua admin. Dengan akun Resend tanpa domain, isi email pemilik akun Resend.
ADMIN_NOTIFY_EMAILS=
